@model WebAppMVCTycoons.Models.UsersModel

@{
    ViewData["Title"] = "AddUser";
}

<h1>AddUser</h1>



<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <h3 class="mb-4">AddUser Form</h3>

            <form asp-controller="UsersOps" asp-action="AddUser" method="post">
                <!-- Control 1 -->
                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <input type="text" class="form-control" asp-for="Name" placeholder="Enter your name">
                </div>

                <!-- Control 2 -->
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" asp-for="Email" placeholder="Enter your email">
                </div>

                <!-- Control 2 -->
                <div class="mb-3">
                    <label for="Password" class="form-label">Password</label>
                    <input type="password" class="form-control" asp-for="Password" placeholder="Enter your email">
                </div>

                <!-- Control 2 -->
                <div class="mb-3">
                    <label for="Dob" class="form-label">Dob</label>
                    <input type="date" class="form-control" asp-for="Dob" placeholder="Enter your email">
                </div>

                <button type="submit" class="btn btn-primary">Submit</button>
            </form>

        </div>
    </div>
</div>


