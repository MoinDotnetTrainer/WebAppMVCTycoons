@model BooksModel

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow border-danger">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        Delete Book
                    </h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        <strong>Warning!</strong>
                        Are you sure you want to delete this book?
                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">
                            Book ID
                        </dt>
                        <dd class="col-sm-8">
                            @Model.BookID
                        </dd>

                        <dt class="col-sm-4">
                            Book Name
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Name
                        </dd>

                        <dt class="col-sm-4">
                            Author
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Author
                        </dd>

                        <dt class="col-sm-4">
                            Price
                        </dt>
                        <dd class="col-sm-8">
                            ₹ @Model.Price
                        </dd>

                    </dl>

                    <hr />

                    <form asp-action="DeleteBook" asp-controller="Books" method="post">

                        <input type="hidden"
                               asp-for="BookID" />

                        <div class="d-flex justify-content-between">

                            <a asp-action="getBooks"
                               class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i>
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                <i class="bi bi-trash"></i>
                                Delete Book
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>
