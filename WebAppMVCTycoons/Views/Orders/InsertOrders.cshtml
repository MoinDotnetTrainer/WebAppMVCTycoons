@model WebAppMVCTycoons.Models.OrdersModel
@{
    ViewData["Title"] = "Add Orders";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


<body class="bg-light">

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card shadow">
                    <div class="card-header bg-primary text-white text-center">
                        <h3>Insert Orders</h3>
                    </div>

                    <div class="card-body">

                        <form asp-controller="Orders" asp-action="InsertOrders" method="post">



                            <!-- Book Name -->
                            <div class="mb-3">
                                <label for="OrderName" class="form-label">Book Name</label>
                                <input type="text"
                                       class="form-control"
                                       asp-for="Name"
                                       placeholder="Enter  Name"
                                       required>
                            </div>

                           

                            <!-- Price -->
                            <div class="mb-3">
                                <label for="price" class="form-label">Price</label>
                                <input type="number"
                                       class="form-control"
                                       id="price"
                                       asp-for="Price"
                                       placeholder="Enter Price"
                                       step="0.01"
                                       required>
                            </div>

                            <!-- Buttons -->
                            <div class="text-center">
                                <button type="submit" class="btn btn-primary">
                                    Insert Book
                                </button>

                                <button type="reset" class="btn btn-secondary">
                                    Clear
                                </button>
                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>

</body>



