@model WebAppMVCTycoons.Models.Values

@{
    ViewData["Title"] = "Div";
}



<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <h3 class="mb-4">Div  Logic</h3>

            <form asp-controller="Data" asp-action="Div" method="post">
                <!-- Control 1 -->
                <div class="mb-3">
                    <label for="Enter X" class="form-label">Enter X</label>
                    <input type="number" class="form-control" asp-for="x" placeholder="Enter  x">
                </div>

                <!-- Control 2 -->
                <div class="mb-3">
                    <label for="Enter y" class="form-label">Enter Y</label>
                    <input type="number" class="form-control" asp-for="y" placeholder="Enter  y">
                </div>

                <input type="submit" class="btn btn-primary" name="Submit" />

                @TempData["msg"]
            </form>

        </div>
    </div>
</div>

